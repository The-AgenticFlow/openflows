# Copy this file to .env.prod. The manager loads .env.prod automatically when
# started from the repository root. Existing exported variables take priority.

OPENFLOWS_MODE=local
OPENFLOWS_MANAGER_ADDR=127.0.0.1:3002
OPENFLOWS_PUBLIC_URL=https://your-tunnel.trycloudflare.com
OPENFLOWS_DATABASE_URL=postgres://openflows:openflows@localhost:5544/openflows_control_plane

OPENFLOWS_AUTH_ALLOW_LOOPBACK=true
OPENFLOWS_AUTH_COOKIE_SECURE=true
OPENFLOWS_DEV_SECRETS_FILE=/absolute/path/to/.local/manager-secrets.json

OPENFLOWS_GITHUB_CLIENT_ID=your-oauth-client-id
OPENFLOWS_GITHUB_CLIENT_SECRET_REF=github-client-secret
OPENFLOWS_CRYPTO_MASTER_KEY_REF=master-key

OPENFLOWS_GITHUB_APP_ID=your-github-app-id
OPENFLOWS_GITHUB_APP_SLUG=your-github-app-slug
OPENFLOWS_GITHUB_PRIVATE_KEY_REF=github-app-private-key
OPENFLOWS_GITHUB_WEBHOOK_SECRET_REF=github-webhook-secret
