# Legacy LOCAL-development example (despite its historical filename).
# New deployments should use .env.openflows.example and the setup/doctor commands.
# Copy this file to .env.prod. The manager loads .env.prod automatically when
# started from the repository root. Existing exported variables take priority.

OPENFLOWS_MODE=local
OPENFLOWS_MANAGER_ADDR=127.0.0.1:3002
OPENFLOWS_PUBLIC_URL=https://your-tunnel.trycloudflare.com
OPENFLOWS_DATABASE_URL=postgres://openflows:openflows@localhost:5544/openflows_control_plane

OPENFLOWS_AUTH_ALLOW_LOOPBACK=true
OPENFLOWS_AUTH_COOKIE_SECURE=true
OPENFLOWS_DEV_SECRETS_FILE=/absolute/path/to/.local/manager-secrets.json
# Use a durable local provider so tenant/runtime secret references survive a
# Manager restart. The development JSON above seeds this directory on start.
OPENFLOWS_SECRET_PROVIDER=filesystem
# Optional verified personal Coder account linking (client issued by Coder).
# OPENFLOWS_CODER_OAUTH_CLIENT_ID=<Coder OAuth application UUID>
# OPENFLOWS_CODER_OAUTH_CLIENT_SECRET_REF=/absolute/path/to/openflows-secrets/coder-oauth-client-secret
OPENFLOWS_SECRET_DIR=/absolute/path/to/.local/openflows-secrets

# Optional local Coder-backed organization provisioning. The bootstrap helper
# reads CODER_SESSION_TOKEN from .env, creates a separate Manager API token, and
# stores it in the development secrets file under the reference below.
CODER_URL=http://127.0.0.1:7080
OPENFLOWS_CODER_OPERATOR_TOKEN_REF=coder-operator-token
OPENFLOWS_PROVISIONER_BACKEND=docker
# Docker provisioners are created automatically for each organization. Defaults
# suit a Manager running on the Docker host. Set an absolute durable directory
# and a container-reachable Coder URL when deploying Manager in a container.
# OPENFLOWS_PROVISIONER_SECRET_DIR=/absolute/path/to/provisioner-secrets
# OPENFLOWS_PROVISIONER_CODER_URL=http://coder:7080
# OPENFLOWS_PROVISIONER_NETWORK=openflows_default
# OPENFLOWS_PROVISIONER_IMAGE=ghcr.io/coder/coder:v2.37.3
# OPENFLOWS_PROVISIONER_DOCKER_SOCKET=/var/run/docker.sock
# OPENFLOWS_DOCKER_BINARY=/usr/bin/docker
OPENFLOWS_RELEASE_SOURCE=local
OPENFLOWS_RELEASE_NAME=2026.10.3
# Required for hosted workspace creation. For local Docker/Coder, obtain it
# with: docker image inspect codercom/enterprise-base:ubuntu --format '{{index .RepoDigests 0}}'
OPENFLOWS_WORKSPACE_IMAGE_DIGEST=sha256:<64-hex-digest>

OPENFLOWS_GITHUB_CLIENT_ID=your-oauth-client-id
OPENFLOWS_GITHUB_CLIENT_SECRET_REF=github-client-secret
OPENFLOWS_CRYPTO_MASTER_KEY_REF=master-key

OPENFLOWS_GITHUB_APP_ID=your-github-app-id
OPENFLOWS_GITHUB_APP_SLUG=your-github-app-slug
OPENFLOWS_GITHUB_PRIVATE_KEY_REF=github-app-private-key
OPENFLOWS_GITHUB_WEBHOOK_SECRET_REF=github-webhook-secret
