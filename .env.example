# ──────────────────────────────────────────────────────────────────────────
# OpenFlows — Environment Configuration
# ──────────────────────────────────────────────────────────────────────────
# Copy this to .env and fill in your values.

# ── GitHub authorization ────────────────────────────────────────────────────
# scripts/setup.sh defaults to connected-local mode for new installations.
# Install the team-owned App and authorize your GitHub account with its public
# client ID. Existing personal-App installs can use self-managed mode.
OPENFLOWS_GITHUB_AUTH_MODE=connected-local
OPENFLOWS_GITHUB_CLIENT_ID=your_openflows_app_public_client_id
OPENFLOWS_GITHUB_APP_SLUG=your_openflows_app_slug

# API base for GitHub Enterprise/Gitea self-hosted. Optional.
# GITHUB_API_BASE=https://api.github.com

# ── Coder (REQUIRED) ──────────────────────────────────────────────────────
# Personal session token from http://localhost:7080/settings/tokens/new.
CODER_SESSION_TOKEN=your_token_here

# ── Self-managed GitHub App, only when OPENFLOWS_GITHUB_AUTH_MODE=self-managed ──
# These values are ignored by the connected-local Compose overlay.
CODER_EXTERNAL_AUTH_0_ID=primary-github
CODER_EXTERNAL_AUTH_0_TYPE=github
CODER_EXTERNAL_AUTH_0_CLIENT_ID=your_github_app_client_id
CODER_EXTERNAL_AUTH_0_CLIENT_SECRET=your_github_app_client_secret
CODER_EXTERNAL_AUTH_0_SCOPES=repo
CODER_EXTERNAL_AUTH_0_APP_INSTALL_URL=https://github.com/apps/<your-app-slug>/installations/new

# ── Coder Agent Lifecycle Hooks ───────────────────────────────────────────
# Secret required; generate with `openssl rand -hex 32`.
CODER_CHAT_HOOK_SECRET=replace_with_32_plus_random_bytes
# OPENFLOWS_HOOK_LOGS=false

# ── Infrastructure ────────────────────────────────────────────────────────
# Only set if you host Redis or Coder elsewhere than the local stack.
# REDIS_URL=redis://localhost:6379
# CODER_URL=http://localhost:7080

# ── Tenant ────────────────────────────────────────────────────────────────
# Namespace for Redis keys and workspace isolation.
OPENFLOWS_TENANT=default

# ── Published images (no compiling) ──────────────────────────────────────
# Used by `setup.sh --compose` (docker-compose.images.yml), which copies the
# programs out of ghcr.io/the-agenticflow/openflows into ./.dev-binaries.
# Version to install, e.g. 1.8.1. Empty uses the `latest` image.
# OPENFLOWS_VERSION=
# Optional image digest (sha256:...) pinning the exact image for that version.
# OPENFLOWS_IMAGE_DIGEST=
# Host user that owns ./.dev-binaries (output of `id -u` / `id -g`).
# OPENFLOWS_HOST_UID=1000
# OPENFLOWS_HOST_GID=1000

# ── Manager foundations ──────────────────────────────────────────────────
# Deployment mode for the OpenFlows Manager. `local` (default) preserves the
# existing operator workflows and does not require a control-plane database.
# `hosted` requires OPENFLOWS_DATABASE_URL; a missing value is a startup
# failure and never silently falls back to local mode.
# OPENFLOWS_MODE=local
# Connected-local runs use GitHub App user tokens. The setup script sets this
# flag and local credential paths; the existing self-managed path keeps it off.
# OPENFLOWS_CONNECTED_LOCAL_ENABLED=false

# Openflows control-plane PostgreSQL URL (separate from Coder's database).
# Start the bundled service with:
#   docker compose --profile manager up -d openflows-db
# OPENFLOWS_DATABASE_URL=postgres://openflows:openflows@localhost:5544/openflows_control_plane
# Bundled development database listens only on loopback by default. Change the
# bind address explicitly only when network access is intended.
# OPENFLOWS_PG_BIND_ADDRESS=127.0.0.1
# OPENFLOWS_PG_PORT=5544

# Secret-provider adapter. The in-memory provider is for tests/local only; a
# production deployment selects a durable backend.
# OPENFLOWS_SECRET_PROVIDER=in-memory

# Test database URL used by the manager PostgreSQL integration tests
# (crates/openflows-manager/tests/). Defaults to the local openflows-db URL.
# OPENFLOWS_TEST_DATABASE_URL=postgres://openflows:openflows@localhost:5544/openflows_control_plane

# ── Template release source ────────────────────────────────────────────
# Operator-configured source of template releases. `local` (default) packages
# the checked-in crates/coder-client/templates directory (dev/tests, no
# network). `github` resolves a pinned, immutable GitHub release. Operator
# config only; customers never supply template URLs.
# OPENFLOWS_RELEASE_SOURCE=local

# For OPENFLOWS_RELEASE_SOURCE=github, the pinned release (never a mutable
# branch or `latest`).
# OPENFLOWS_GITHUB_TEMPLATE_REPOSITORY=The-AgenticFlow/openflows-templates
# OPENFLOWS_GITHUB_TEMPLATE_TAG=2026.10.0
# OPENFLOWS_TEMPLATE_MANIFEST_SHA256=<64-char sha256 of the manifest.json asset>
# Optional secret-provider reference when the template repository is private.
# OPENFLOWS_GITHUB_TEMPLATE_TOKEN_REF=github-template-read-token

# GitHub API base (default https://api.github.com).
# OPENFLOWS_GITHUB_API_BASE=https://api.github.com
# Maximum bytes accepted for one downloaded artifact (default 256 MiB).
# OPENFLOWS_RELEASE_MAX_DOWNLOAD_BYTES=268435456
# Per-request download timeout in seconds (default 30).
# OPENFLOWS_RELEASE_TIMEOUT_SECS=30
# Directory for the bounded verified-artifact cache (default
# .openflows/release-cache), so restarts/retries do not re-download.
# OPENFLOWS_RELEASE_CACHE_DIR=.openflows/release-cache
