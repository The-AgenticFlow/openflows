#!/usr/bin/env bash
# Keep a hosted workspace's Manager session and GitHub credentials fresh.
#
#   openflows-credential-refresh [--api-token]
#
# Started in the background by of_start_credential_refresh (runtime/lib/bootstrap.sh)
# with OF_MANAGER_URL, OF_RUNTIME_ACCESS_TOKEN and OF_RUNTIME_REFRESH_TOKEN in its
# environment, and OF_CONNECTED_LOCAL. Once bootstrap creates the ready file it:
#   - sends a liveness heartbeat every 30 seconds, refreshing the session on 401;
#   - every 8 minutes refreshes the session and rewrites git's stored credential
#     with a new git-purpose token (and, with --api-token, the harness's API token
#     file), because installation tokens are short-lived and a push can outlive one.
# In connected-local mode git asks the connected-local helper, so no git token is
# written to disk; the API token file is refreshed with the git-purpose token, as
# startup does.
# Every failure skips to the next cycle: a Manager outage must not end the workspace.
#
# Tokens stay in shell variables: they are removed from the environment its
# commands inherit, request bodies go to curl on stdin and the Authorization
# header through a file descriptor, so no token appears in a process argument list.
#
# OF_READY_FILE, OF_API_TOKEN_FILE, OF_GIT_CREDENTIALS, OF_REFRESH_INTERVAL
# (seconds between heartbeats) and OF_REFRESH_ROTATE_EVERY (heartbeats between
# token rotations) override the defaults, for tests.

set -u

READY="${OF_READY_FILE:-/tmp/openflows-manager-ready}"
API_TOKEN_FILE="${OF_API_TOKEN_FILE:-/home/coder/.config/openflows/github-api-token}"
GIT_CREDENTIALS="${OF_GIT_CREDENTIALS:-/home/coder/.git-credentials}"
INTERVAL="${OF_REFRESH_INTERVAL:-30}"
ROTATE_EVERY="${OF_REFRESH_ROTATE_EVERY:-16}"
MANAGER="${OF_MANAGER_URL:?OF_MANAGER_URL is required}"
ACCESS="${OF_RUNTIME_ACCESS_TOKEN:?OF_RUNTIME_ACCESS_TOKEN is required}"
REFRESH="${OF_RUNTIME_REFRESH_TOKEN:?OF_RUNTIME_REFRESH_TOKEN is required}"
CONNECTED_LOCAL="${OF_CONNECTED_LOCAL:-false}"
unset OF_RUNTIME_ACCESS_TOKEN OF_RUNTIME_REFRESH_TOKEN OF_BOOTSTRAP
WITH_API=0
[ "${1:-}" = --api-token ] && WITH_API=1

json_field() { python3 -c 'import json,sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1" 2>/dev/null; }

# bearer TOKEN CURL_ARG... — curl authorized with TOKEN, read from a descriptor.
bearer() {
    local token="$1"
    shift
    curl -H @<(printf 'Authorization: Bearer %s\n' "$token") "$@"
}

# refresh_session — replace ACCESS and REFRESH only when both new values arrive.
refresh_session() {
    local response access refresh
    response=$(printf '{"refresh_token":"%s"}' "$REFRESH" |
        bearer "$REFRESH" -fsS -H 'Content-Type: application/json' --data @- \
            "${MANAGER}/api/v1/runtime/refresh" 2>/dev/null) || return 1
    access=$(printf '%s' "$response" | json_field access_token) || return 1
    refresh=$(printf '%s' "$response" | json_field refresh_token) || return 1
    [ -n "$access" ] && [ -n "$refresh" ] || return 1
    ACCESS="$access"
    REFRESH="$refresh"
}

broker_token() { # broker_token PURPOSE
    local response
    response=$(printf '{"purpose":"%s"}' "$1" |
        bearer "$ACCESS" -fsS -H 'Content-Type: application/json' --data @- \
            "${MANAGER}/api/v1/runtime/github-credentials" 2>/dev/null) || return 1
    printf '%s' "$response" | json_field token
}

heartbeat_status() {
    bearer "$ACCESS" -s -o /dev/null -w '%{http_code}' -X POST "${MANAGER}/api/v1/runtime/heartbeat"
}

ticks=0
while true; do
    sleep "$INTERVAL"
    if [ ! -f "$READY" ]; then continue; fi
    ticks=$((ticks + 1))
    status=$(heartbeat_status)
    if [ "$status" = 401 ]; then
        refresh_session || continue
        heartbeat_status >/dev/null || true
    fi
    if [ "$ticks" -lt "$ROTATE_EVERY" ]; then continue; fi
    ticks=0
    refresh_session || continue
    git_token=$(broker_token git) || continue
    [ -n "$git_token" ] || continue
    if [ "$WITH_API" = 1 ]; then
        if [ "$CONNECTED_LOCAL" = true ]; then
            api_token="$git_token"
        else
            api_token=$(broker_token api) || continue
        fi
        [ -n "$api_token" ] || continue
    fi
    if [ "$CONNECTED_LOCAL" != true ]; then
        (umask 077 && printf 'https://x-access-token:%s@github.com\n' "$git_token" > "$GIT_CREDENTIALS")
    fi
    if [ "$WITH_API" = 1 ]; then
        tmp=$(mktemp "$API_TOKEN_FILE.XXXXXX") || continue
        printf '%s' "$api_token" > "$tmp"
        mv -f "$tmp" "$API_TOKEN_FILE"
    fi
done
